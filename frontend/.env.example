# DiabetaCare Frontend Environment Variables

# API Base URL (without trailing slash)
# For development with XAMPP
NEXT_PUBLIC_API_URL=http://localhost/diabetic-patient-management-system/backend/public/index.php/api

# For development with PHP built-in server (alternative)
# NEXT_PUBLIC_API_URL=http://localhost:8080/api

# For production, update to your API domain:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
